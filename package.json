{
  "name": "moss-taste",
  "private": true,
  "version": "0.8.2",
  "description": "Recetario familiar: ingredientes y costo en COP para cualquier número de porciones.",
  "keywords": [
    "recetario",
    "recetas",
    "cocina colombiana",
    "porciones",
    "costos",
    "react",
    "vite"
  ],
  "homepage": "https://sergio-velandia.dev/Moss-Taste/",
  "bugs": {
    "url": "https://github.com/Sergio-Velandia/Moss-Taste/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergio-Velandia/Moss-Taste.git"
  },
  "author": "Sergio Velandia",
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:reglas": "npx --yes firebase-tools@15.35.0 emulators:exec --only firestore --project demo-moss-taste \"vitest run --config vitest.reglas.config.ts\"",
    "typecheck": "tsc -b",
    "imagenes": "node scripts/imagenes.ts"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
