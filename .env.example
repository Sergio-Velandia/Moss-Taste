# Configuración web de Firebase (Authentication y Firestore). No es secreta: viaja al navegador.
# Lo que protege los datos son las reglas de Firestore y la restricción de la clave por dominio.
# Copia este archivo como .env y llena los valores. En GitHub van en Settings → Secrets and variables
# → Actions → pestaña Variables, con estos mismos nombres. Sin ellos el sitio funciona, pero sin cuentas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
